# =============================================================================
# matrix.env — Matriz de experimentos para scripts/run_matrix.sh
# Cada combinación (escenario × transporte × ruido × middleware) se ejecuta
# REPETITIONS veces; dentro de cada bloque el orden de middlewares se aleatoriza
# (semilla SEED) para no confundir deriva del testbed con efecto del middleware.
# =============================================================================

MIDDLEWARES="fastdds cyclonedds"
TRANSPORTS="udp udpm"
NOISE_PROFILES="none udp_saturate tcp_bulk udp_burst"
NOISE_TARGET=reader          # reader | writer | both | cross
NOISE_BW=950M                # por fuente (3 fuentes -> incast ~3:1 sobre 1 GbE)
REPETITIONS=3
SEED=20261013

# Duraciones (s): con ruido = baseline + ruido + recuperación
WARMUP=5
BASELINE=30
NOISE_DURATION=60
RECOVERY=30

# Escenarios de QoS: "nombre=argumentos comunes para pub y sub"
SCENARIOS=(
  "reliable_keeplast=--reliability reliable"
  "best_effort=--reliability best_effort"
  "strict_prealloc=--qos-profile radar=radar_rt,sonar=sonar_rt,weather=weather_rt --fastdds-memory-policy preallocated"
  "keep_all=--history keep_all --max-samples-per-instance 64 --max-samples 4096"
  "latency_budget_1ms=--latency-budget-us 1000"
  "liveliness_manual=--liveliness manual_topic --lease-ms 200"
)

# Escenarios colocalizados (SHM / zero-copy en el Data Writer). DEADLINE
# infinito: iceoryx (Cyclone PSMX) no admite DEADLINE finito; se aplica a
# ambos middlewares para comparar en igualdad de condiciones.
SHM_TRANSPORTS="shm zc"
SHM_NOISE_PROFILES="none"
SHM_SCENARIOS=(
  "colocated_nodeadline=--deadline-ms 0"
)
