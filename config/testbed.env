# =============================================================================
# testbed.env — Definición del testbed para scripts/run_benchmark.sh y
# scripts/run_matrix.sh. Ajustar a la instalación real.
#
#   Data Writer (PREEMPT_RT) ──┐
#   Data Reader (PREEMPT_RT) ──┤
#   Servidor de Ruido ─────────┼── Switch Ethernet estándar (sin TSN)
#   RPI Ruido 1 / RPI Ruido 2 ─┘
#
# Un HOST con valor "local" ejecuta el comando en esta máquina sin SSH.
# Los accesos SSH deben ser sin contraseña (BatchMode) desde el orquestador.
# =============================================================================

# --- Acceso SSH (usuario@host) -----------------------------------------------
WRITER_HOST=bench@10.10.0.11
READER_HOST=bench@10.10.0.12
NOISE_SERVER_HOST=bench@10.10.0.20
NOISE_RPI1_HOST=pi@10.10.0.21
NOISE_RPI2_HOST=pi@10.10.0.22

# --- Direcciones en la red de pruebas (destinos de iperf3) -------------------
WRITER_IP=10.10.0.11
READER_IP=10.10.0.12
NOISE_SERVER_IP=10.10.0.20

# --- Interfaz de la red de pruebas en los nodos RT ---------------------------
WRITER_IFACE=enp3s0
READER_IFACE=enp3s0

# --- Instalación remota -------------------------------------------------------
# Binarios (cmake --install build --prefix $REMOTE_BENCH_PREFIX) y middleware
REMOTE_BENCH_PREFIX=/opt/dds_bench
REMOTE_DDS_PREFIX=/opt/dds
REMOTE_RESULTS_DIR=/var/tmp/dds_bench_results
REMOTE_PHASE_DIR=/run/dds_bench
# Prefijo para privilegios RT (SCHED_FIFO, mlockall, /dev/cpu_dma_latency).
# Vacío si el usuario tiene rtprio/memlock en limits.d (tune_host_rt.sh apply).
SUDO="sudo -n"

# --- Particionado de CPUs en los nodos RT (ej. 4 núcleos) --------------------
#   CPU 0-1: housekeeping (SO, IRQs ajenas, hilo de métricas, servidor iperf3)
#   CPU 2  : hilos RT de la aplicación (writer/reader/eco)  SCHED_FIFO 80/79
#   CPU 3  : hilos del middleware + IRQ de la NIC           SCHED_FIFO 70 / 85
APP_CPUS=2
MW_CPUS=3
HK_CPUS=0,1
APP_PRIO=80
MW_PRIO=70
CPU_DMA_LATENCY=0

# --- DDS ----------------------------------------------------------------------
DOMAIN_ID=42
MCAST_ADDR=239.255.0.2
